# ──────────────────────────────────────────────────────────────────────────
# SCIENTIFIC DATA ORCHESTRATOR (SDO) - PRODUCTION ENVIRONMENT TEMPLATE
# ──────────────────────────────────────────────────────────────────────────

# 1. API Server Settings
API_PORT=8000
FRONTEND_URL=http://localhost
MAX_WORKERS=4

# 2. Storage & Directory Configurations
DATABASE_URL=sqlite:///sutrix_science.db
SDO_UPLOAD_DIR=uploads
SDO_OUTPUT_DIR=outputs
SDO_MAX_FILE_SIZE_MB=100

# 3. API Integrations & Core Plugins
SDO_API_RATE_LIMIT=0.1
SDO_API_CACHE=true

# 4. Observability & Monitoring
# Set your Sentry DSN here for enterprise exception tracking in production
SENTRY_DSN=
# Set Secret key for cryptographic signing of session data
SECRET_KEY=sdo_production_secure_secret_key_change_me_in_prod

# 5. Open Source AGPL-3.0 Compliance Details
# Set repository link to comply with Section 13 matching source code access
AGPL_SOURCE_URL=https://github.com/ScientificDataOrchestrator/sdo
