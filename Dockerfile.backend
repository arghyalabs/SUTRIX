# Scientific runtime base stage
FROM python:3.11-slim

# Set environment paths and python configs
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=off \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PIP_DEFAULT_TIMEOUT=100

WORKDIR /app

# Install essential system utilities and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxrender1 \
    libxext6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy python dependencies list first
COPY "Scientific Data Orchestrator/requirements.txt" ./
RUN pip install --no-cache-dir -r requirements.txt

# Install API Gateway core dependencies explicitly (FastAPI & production Gunicorn servers)
RUN pip install --no-cache-dir \
    fastapi==0.110.0 \
    pydantic==2.6.4 \
    uvicorn==0.28.0 \
    gunicorn==21.2.0 \
    httpx==0.27.0 \
    pyarrow==15.0.0

# Copy entire scientific project codebase
COPY "Scientific Data Orchestrator/" ./

EXPOSE 8000

# Start FastAPI application using Gunicorn serving high-performance Uvicorn workers
CMD ["gunicorn", "backend.main:app", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "-b", "0.0.0.0:8000", "--timeout", "300"]
